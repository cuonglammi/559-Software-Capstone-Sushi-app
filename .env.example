# Export these values in your shell; .env is not loaded automatically.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production requires a long random secret, DEBUG=false, and HTTPS.
# DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/sushi
# TRUST_PROXY=true
# CSRF_TRUSTED_ORIGINS=https://your-app.example.com
